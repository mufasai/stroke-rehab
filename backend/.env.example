# Application
PROJECT_NAME=Stroke Hand Therapy API
VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=sqlite:///./rehab_stroke.db
# For PostgreSQL production:
# DATABASE_URL=postgresql://user:password@localhost:5432/rehab_stroke

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Environment
ENVIRONMENT=development
